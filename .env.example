# ─── Local Development (outside Docker) ───────────────────────
# Used by: npm run dev, npm run db:migrate, npm run db:seed
DATABASE_URL=postgres://postgres:secret@localhost:5432/mood_board

# ─── Docker Compose (inside containers) ───────────────────────
# Used by: compose.yaml for the next service
DOCKER_DATABASE_URL=postgres://postgres:secret@db:5432/mood_board

# ─── PostgreSQL Container ──────────────────────────────────────
# Used by: compose.yaml for the db service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=mood_board